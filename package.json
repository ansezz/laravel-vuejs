{
  "name": "laravel-vuejs",
  "version": "3.0.0",
  "description": "Laravel & VueJs blog — static Astro build of laravel-vuejs.space",
  "author": "Anass EZ-ZOUAINE <ansezzouaine@gmail.com>",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/markdown.mjs && node scripts/csp.mjs",
    "preview": "astro preview",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "check:packages": "node --experimental-strip-types scripts/check-packages.mjs",
    "check:tools": "node --experimental-strip-types scripts/check-tools.mjs",
    "check:live": "node scripts/check-live.mjs",
    "lhci": "npx --yes @lhci/cli@0.15.x autorun",
    "check:worker": "tsc -p worker",
    "db:migrate:local": "wrangler d1 migrations apply laravel-vuejs-forms --local",
    "diagrams": "node scripts/diagrams.mjs",
    "cheatsheets:pdf": "node --experimental-strip-types scripts/cheatsheets-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@shikijs/transformers": "^4.5.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261009.1",
    "shiki": "^4.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
