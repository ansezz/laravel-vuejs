# All optional. Values are read at build time (PUBLIC_* are exposed to the browser).

# Google AdSense publisher id (e.g. ca-pub-1234567890). Leave empty to render no ads.
PUBLIC_GOOGLE_ADSENSE=
# Google Analytics (gtag) measurement id and/or Google Tag Manager container id.
PUBLIC_GOOGLE_ANALYTICS=
PUBLIC_GOOGLE_TAG_MANAGER=
# Google Search Console verification token for laravel-vuejs.space.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# GraphQL endpoint for the forms (signup, login, subscribe, contact). Without it the forms
# show an error toast instead of submitting, because the static site has no backend.
PUBLIC_GRAPHQL_URL=
