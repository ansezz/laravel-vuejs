---
import Page from '../../layouts/Page.astro'
import Icon from '../../components/Icon.astro'
import JobsNav from '../../components/JobsNav.astro'
import FormGuard from '../../components/FormGuard.astro'
import { GROUPS } from '../../config/site'
const types = ['Full-time', 'Part-time', 'Contract', 'Freelance', 'Internship']
---
<Page title="Post a job" kicker="Jobs" heading="Post a Laravel or Vue job" lead="Reach developers who know the stack. Free in the community group, or featured across our channels.">
  <JobsNav slot="hero" />
  <section class="container section-tight">
    <div class="steps grid grid-3">
      <div class="card step reveal"><h3>Send the listing</h3><p class="muted">Fill in the form below: role, stack, location, budget and how to apply. Listings with a budget get far more replies.</p></div>
      <div class="card step reveal"><h3>We review it</h3><p class="muted">A human checks every listing within two working days and emails you before it goes out. No recruiters spamming, no fake roles.</p></div>
      <div class="card step reveal"><h3>It reaches the community</h3><p class="muted">Free listings go to <a class="link-arrow" href={GROUPS[1].url} rel="noopener" target="_blank">{GROUPS[1].name}</a>. Featured ones also go to our page, channels and newsletter. See <a class="link-arrow" href="/jobs/pricing">pricing</a>.</p></div>
    </div>
  </section>
  <section class="container-narrow section-tight" id="submit">
    <form class="card form-card" action="/api/forms/job" method="post" data-api>
      <h2 style="font-size:1.35rem;margin:0">Job details</h2>
      <div class="grid grid-2" style="gap:16px">
        <div class="field"><label for="j-role">Role title</label><input class="input" id="j-role" name="role" required maxlength="140" placeholder="Senior Laravel + Vue developer"></div>
        <div class="field"><label for="j-type">Type</label><select class="input" id="j-type" name="type">{types.map(t => <option>{t}</option>)}</select></div>
        <div class="field"><label for="j-company">Company</label><input class="input" id="j-company" name="company" required maxlength="120" autocomplete="organization"></div>
        <div class="field"><label for="j-url">Company website <span class="opt">(optional)</span></label><input class="input" id="j-url" name="company_url" type="url" maxlength="300" placeholder="https://"></div>
        <div class="field"><label for="j-location">Location</label><input class="input" id="j-location" name="location" maxlength="120" placeholder="Remote (UTC±3), or a city"></div>
        <div class="field"><label for="j-budget">Budget or salary</label><input class="input" id="j-budget" name="budget" maxlength="80" placeholder="$60–80k, or $50/h"></div>
      </div>
      <div class="field"><label for="j-stack">Stack</label><input class="input" id="j-stack" name="stack" maxlength="200" placeholder="Laravel 13, Vue 3, Inertia 3, MySQL"></div>
      <div class="field"><label for="j-desc">What the person will do</label><textarea class="input" id="j-desc" name="description" required minlength="30" maxlength="8000" placeholder="Responsibilities, team, requirements, nice-to-haves."></textarea></div>
      <div class="field"><label for="j-apply">How to apply</label><input class="input" id="j-apply" name="apply" required maxlength="300" placeholder="Apply link or email address"></div>
      <h2 style="font-size:1.1rem;margin:8px 0 0">About you</h2>
      <div class="grid grid-2" style="gap:16px">
        <div class="field"><label for="j-name">Your name</label><input class="input" id="j-name" name="name" required maxlength="100" autocomplete="name"></div>
        <div class="field"><label for="j-email">Your email</label><input class="input" id="j-email" name="email" type="email" required autocomplete="email"></div>
      </div>
      <label class="check"><input type="checkbox" name="featured" value="yes"> I'm interested in a featured listing (we'll send options and rates)</label>
      <div><button class="btn btn-primary" type="submit">Submit job for review <Icon name="arrow" size={16} class="icon-arrow" /></button>
      <FormGuard />
      <p class="form-note">Prefer to post it yourself? Share it for free in <a class="link-arrow" href={GROUPS[1].url} rel="noopener" target="_blank">{GROUPS[1].name}</a>.</p></div>
    </form>
  </section>
</Page>
