---
import Page from '../layouts/Page.astro'
import Icon from '../components/Icon.astro'
import { CONTACT_EMAIL } from '../config/site'
---
<Page title="Form not sent" kicker="Oops" heading="That didn't go through." lead="Something in the form needs another look, or you sent several messages in a short time." noindex>
  <section class="container-narrow section-tight">
    <p class="lead" id="reason" hidden></p>
    <p>Go back, check the fields and try again. If it keeps failing, email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    <div class="hero-cta"><button class="btn btn-primary" type="button" onclick="history.back()">Go back to the form</button><a class="btn" href="/">Home <Icon name="arrow" size={16} class="icon-arrow" /></a></div>
  </section>
  <script is:inline>
    var r = new URLSearchParams(location.search).get('reason'); var el = document.getElementById('reason'); if (r && el) { el.textContent = r; el.hidden = false }
  </script>
</Page>
