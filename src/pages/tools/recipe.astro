---
import ToolPage from '../../components/ToolPage.astro'
import PackageInstall from '../../components/PackageInstall.astro'
import { RECIPE_JOBS, defaultJobIds, recipeFromJobs } from '../../data/dev-tools'
const recipe = recipeFromJobs(defaultJobIds())
const lead = 'Tick the jobs. The commands use the same packages as the chart. They do not pin versions.'
---
<ToolPage title="Stack recipe" lead={lead}>
  <p class="pkg-set-note">{lead}</p>
  <form class="tool-layout" data-recipe>
    <fieldset class="tool-choices">
      <legend class="sr-only">Jobs to install</legend>
      {RECIPE_JOBS.map(job => (
        <label class="tool-choice">
          <input type="checkbox" data-job={job.id} checked={job.defaultOn} />
          <span>
            <strong>{job.label}</strong>
            <span>{job.detail}</span>
          </span>
        </label>
      ))}
    </fieldset>
    <div class="tool-output">
      <h2>Composer</h2>
      <div data-recipe-composer-wrap hidden={recipe.composer === null}>
        <PackageInstall command={recipe.composer ?? ''} />
      </div>
      <p class="pkg-set-note" data-recipe-composer-empty hidden={recipe.composer !== null}>No PHP packages in this recipe.</p>
      <h2>npm</h2>
      <div data-recipe-npm-wrap hidden={recipe.npm === null}>
        <PackageInstall command={recipe.npm ?? ''} />
      </div>
      <p class="pkg-set-note" data-recipe-npm-empty hidden={recipe.npm !== null}>No npm packages in this recipe.</p>
      <h2>Check before you install</h2>
      <ul class="tool-warnings" data-recipe-warnings hidden={recipe.warnings.length === 0}>
        {recipe.warnings.map(warning => <li>{warning}</li>)}
      </ul>
      <p class="pkg-set-note" data-recipe-warnings-empty hidden={recipe.warnings.length > 0}>No mix-up in the current ticks.</p>
      <h2>Markdown card</h2>
      <div class="code pkg-install">
        <div class="code-head">
          <span class="code-lang">markdown</span>
          <button type="button" class="copy-btn" aria-label="Copy Markdown card">
            <svg class="i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="i-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <pre><code data-recipe-md>{recipe.markdown}</code></pre>
      </div>
    </div>
  </form>
</ToolPage>
