---
import Base from '../../layouts/Base.astro'
import { clip } from '../../lib/content'
import PageHero from '../../components/PageHero.astro'
import { traps } from '../../data/traps'

const description = 'Machine checks, the setup commands in order, the lines the setup guide shows, a stack recipe, a file map, October release notes, a 2019 to 2026 pick list, a compatibility card, and an AGENTS.md file for Laravel and Vue projects.'
const tools = [
  { href: '/starter', title: 'Starter prompt', lead: 'Tick Laravel and Vue modules. Copy one prompt that reads those guides.' },
  { href: '/fix', title: 'Fix the app you have', lead: 'Paste an error, or composer.json and package.json. Copy the prompt for the matching guides.' },
  { href: '/trap', title: 'Catch the bad line', lead: `${traps.length} prompts. One line in each would break the app. Click that line.` },
  { href: '/strike', title: 'Cross out the bad line', lead: 'Paste your instructions. Cross out a line the guides forbid. Copy what is left.' },
  { href: '/which', title: 'Which file', lead: 'Four files. One line would break the app. Open the file and click that line.' },
  { href: '/spin', title: "Today's project", lead: 'Run the reel. It stops on one project you can build today. Copy the prompt.' },
  { href: '/tools/start', title: 'Start here', lead: 'Machine checks from the requirements article, then the commands in the order the setup guide runs them.' },
  { href: '/tools/samples', title: 'Samples', lead: 'Lines the setup guide prints. A method or a class body is not a whole file.' },
  { href: '/tools/recipe', title: 'Stack recipe', lead: 'Tick the jobs. The commands use the same packages as the chart. They do not pin versions.' },
  { href: '/tools/files', title: 'Where it goes', lead: 'Paths the setup guide names for the official Vue starter kit.' },
  { href: '/tools/shipped', title: 'What shipped', lead: 'New opt-in APIs from the release articles published here, Laravel 13.35 to 13.38, Inertia 3.9, Wayfinder and the AI SDK.' },
  { href: '/tools/now', title: 'Then and now', lead: 'The 2019 stack next to the 2026 pick, from the requirements article.' },
  { href: '/tools/compatibility', title: 'Compatibility', lead: 'Copied from published articles on this site. Not a live compatibility API.' },
  { href: '/tools/agents', title: 'AGENTS.md', lead: 'Pick the stack. Download a rules file, or fetch the default one.' },
]
---
<Base title="Tools" description={clip(description, 155)}>
  <PageHero
    kicker="For developers and assistants"
    title="Tools"
    lead="Check the machine, run the setup commands in order, paste the lines the guide shows, pick a stack, see where each file goes, read the October release notes, compare 2019 with 2026, and download a rules file an assistant can follow."
    crumbs={[{ label: 'Tools' }]}
  />
  <section class="container section-tight">
    <div class="grid grid-2 tool-index">
      {tools.map(tool => (
        <a class="card tile" href={tool.href}>
          <h2>{tool.title}</h2>
          <p>{tool.lead}</p>
        </a>
      ))}
    </div>
  </section>
  <script is:inline>
    const tools = {
      '#start': '/tools/start',
      '#samples': '/tools/samples',
      '#recipe': '/tools/recipe',
      '#files': '/tools/files',
      '#shipped': '/tools/shipped',
      '#now': '/tools/now',
      '#compatibility': '/tools/compatibility',
      '#agents': '/tools/agents',
    }
    const next = tools[location.hash]
    if (next) location.replace(next)
  </script>
</Base>
