---
import Base from '../../layouts/Base.astro'
import Root from '../../app/roots/Tag.vue'
import { allPosts, tags, pageState, paginate } from '../../lib/content'

// pages/tag/_slug + middleware/tag.js (tagBySlug, postsByTag)
export function getStaticPaths() {
  return tags.map((tag) => ({ params: { slug: tag.slug }, props: { tag } }))
}
const { tag } = Astro.props
const posts = (await allPosts()).filter(p => p.tags.some((t: any) => t.slug === tag.slug))
const state = await pageState(Astro.url, { name: 'tag-slug', params: { slug: tag.slug } }, { tag: { tag, posts: paginate(posts, 12) } })
---
<Base seo={{ title: tag.name, description: tag.name }} state={state}>
  <Root client:load />
</Base>
