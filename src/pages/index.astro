---
import Base from '../layouts/Base.astro'
import PostCard from '../components/PostCard.astro'
import Icon from '../components/Icon.astro'
import NewsletterBand from '../components/NewsletterBand.astro'
import { allPosts, categories } from '../lib/content'
import Art from '../components/Art.astro'
import { SOCIALS, GROUPS } from '../config/site'
import { categoryArt } from '../lib/art'
import AgentTask from '../components/AgentTask.astro'
import { agentTasks, firstApp } from '../data/agent-tasks'
const jobsArt = categoryArt('jobs')!

const posts = await allPosts()
const [lead, ...rest] = posts
const count = (slug: string) => posts.filter(p => p.categories.some(c => c.slug === slug)).length
const topicIcon: Record<string, string> = { laravel: 'layers', vuejs: 'code', jobs: 'briefcase', ebooks: 'book' }
const stack = ['Laravel 13', 'PHP 8.3+', 'Vue 3.5', 'Inertia 3', 'TypeScript', 'Vite 8', 'Tailwind CSS 4', 'Pest', 'Nuxt 4', 'Pinia']
---
<Base description="Practical guides, tutorials and a friendly community for developers building modern apps with Laravel and Vue.">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container poster">
      <a class="eyebrow" href="/laravel-vuejs-open-source-cms"><b>NEW</b> We moved to laravel-vuejs.space <Icon name="arrow" size={14} /></a>
      <div class="poster-stage">
        <div class="poster-copy">
          <h1>
            <span class="poster-kicker">Build modern apps with</span>
            <span class="poster-stack">
              <span class="ink-laravel">Laravel</span>
              <span class="ink-row">
                <span class="ink-amp">&amp;</span>
                <span class="ink-vue">Vue.</span>
              </span>
            </span>
          </h1>
          <p class="lead">Clear, up-to-date guides for the stack you love: Laravel 13 on the back end, Vue 3 on the front end, and everything in between. Written by developers, for developers.</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="/posts">Read the guides <Icon name="arrow" size={18} class="icon-arrow" /></a>
            <a class="btn" href="/page/about-us"><Icon name="users" size={18} /> Join the community</a>
          </div>
          <div class="hero-meta">
            <span><Icon name="zap" size={16} /> Free and open source</span>
            <span><Icon name="code" size={16} /> Real code you can copy</span>
            <span><Icon name="globe" size={16} /> 8 community channels</span>
          </div>
        </div>
        <div class="showcase">
          <div class="window" aria-label="Code example: a Laravel route rendering a Vue page with Inertia">
            <div class="window-bar"><i></i><i></i><i></i>
              <div class="window-tabs"><span class="on">routes/web.php</span><span>Posts.vue</span></div>
            </div>
<pre><code><span class="c">// Laravel 13 + Inertia 3</span>
<span class="t">Route</span>::<span class="f">get</span>(<span class="s">'/posts'</span>, <span class="k">fn</span> () =&gt; <span class="t">Inertia</span>::<span class="f">render</span>(<span class="s">'Posts'</span>, [
    <span class="s">'posts'</span> =&gt; <span class="t">Post</span>::<span class="f">latest</span>()-&gt;<span class="f">paginate</span>(),
]));

<span class="c">&lt;!-- resources/js/pages/Posts.vue --&gt;</span>
&lt;<span class="k">script</span> <span class="f">setup</span> <span class="f">lang</span>=<span class="s">"ts"</span>&gt;
<span class="k">defineProps</span>&lt;&#123; posts: <span class="t">Paginated</span>&lt;<span class="t">Post</span>&gt; &#125;&gt;()
&lt;/<span class="k">script</span>&gt;

&lt;<span class="k">template</span>&gt;
  &lt;<span class="t">PostCard</span> <span class="f">v-for</span>=<span class="s">"post in posts.data"</span> <span class="f">:post</span>=<span class="s">"post"</span> /&gt;
&lt;/<span class="k">template</span>&gt;</code></pre>
            <div class="poster-notes">
              <span class="float-chip chip-a" aria-hidden="true"><i class="dot"></i> 42 tests passed</span>
              <span class="float-chip chip-b" aria-hidden="true"><b>SSR</b> Inertia 3 + Vue 3.5</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="starter-band" aria-labelledby="starter-home">
    <div class="container starter-band-grid">
      <div>
        <p class="kicker">Starter prompt</p>
        <h2 id="starter-home">A Laravel and Vue app, from one prompt</h2>
        <p>Laravel 13 is the back end. Vue 3 is the front end. Tick login, social login, Passport, and the screens you need.</p>
        <ol class="starter-steps">
          <li><span><b>Laravel and Vue.</b> Always on. Inertia, a Sanctum SPA, or Nuxt in front.</span></li>
          <li><span><b>Accounts.</b> Login, social login, roles, and Passport when another product needs OAuth.</span></li>
          <li><span><b>The prompt.</b> Each tick quotes that guide, including what not to do.</span></li>
        </ol>
        <a class="btn btn-primary" href="/starter">Build a starter prompt <Icon name="arrow" size={18} class="icon-arrow" /></a>
        <p class="starter-also"><a href="/fix">Already have an app? Paste the error or the lockfiles.</a></p>
        <p class="starter-also"><a href="/trap">Catch the bad line in a prompt.</a></p>
        <p class="starter-also"><a href="/strike">Cross out the bad line in yours.</a></p>
        <p class="starter-also"><a href="/which">Open the file with the bad line.</a></p>
        <p class="starter-also"><a href="/spin">Run the reel. It stops on one project.</a></p>
      </div>
      <div class="starter-sheet" aria-hidden="true">
        <p class="starter-sheet-label">Always on</p>
        <div class="starter-row on"><i></i><span><b>Laravel 13</b><small>The back end on every prompt.</small></span></div>
        <div class="starter-row on"><i></i><span><b>Vue 3</b><small>The front end on every prompt.</small></span></div>
        <p class="starter-sheet-label">How they connect</p>
        <div class="starter-row on"><i></i><span><b>Inertia app</b><small>Fortify login screens included.</small></span></div>
        <div class="starter-row"><i></i><span><b>Sanctum SPA</b><small>Laravel API and a cookie login.</small></span></div>
        <div class="starter-row"><i></i><span><b>Nuxt site</b><small>Laravel stays the API.</small></span></div>
        <p class="starter-sheet-label">Accounts</p>
        <div class="starter-picks">
          <span class="on">Login</span>
          <span>Social login</span>
          <span>Passport</span>
          <span class="on">Who can edit</span>
          <span>Roles</span>
          <span class="on">Posts</span>
          <span class="on">Deploy</span>
        </div>
        <pre class="starter-snippet">Laravel 13 and Vue 3.
Read /laravel-fortify-vue.md
Login, registration, and password reset.
Show the diff. Do not commit.</pre>
      </div>
    </div>
  </section>

  <section class="container ask-section" aria-labelledby="ask">
    <div class="section-head">
      <div>
        <p class="kicker">For your AI agent</p>
        <h2 id="ask">What are you about to ask?</h2>
        <p>Copy a prompt into the AI agent you already have open. Read the article when you want the reason.</p>
      </div>
    </div>
    <div class="grid grid-2 ask-grid">
      <div class="ask-lead"><AgentTask task={firstApp} compact /></div>
      {agentTasks.map(task => <AgentTask task={task} compact />)}
    </div>
  </section>

  <section class="container stats-wrap" aria-label="At a glance">
    <dl class="stats reveal">
      <div><dt>Since</dt><dd>2019</dd><dd class="sub">sharing Laravel &amp; Vue</dd></div>
      <div><dt>Channels</dt><dd>8</dd><dd class="sub">groups, pages &amp; feeds</dd></div>
      <div><dt>Guides</dt><dd>{posts.length}</dd><dd class="sub">updated for 2026</dd></div>
      <div><dt>Cookies</dt><dd>0</dd><dd class="sub">set by the site, cookieless analytics</dd></div>
    </dl>
  </section>

  <section class="container section-tight" aria-labelledby="latest">
    <div class="section-head">
      <div><p class="kicker">Latest</p><h2 id="latest">Fresh from the blog</h2></div>
      <a class="link-arrow" href="/posts">All articles <Icon name="arrow" size={16} /></a>
    </div>
    {lead && <PostCard post={lead} feature eager />}
    <div class="grid grid-2" style="margin-top:24px">
      {rest.map(p => <PostCard post={p} />)}
    </div>
  </section>

  <section class="container section-tight" aria-labelledby="topics">
    <div class="section-head">
      <div><p class="kicker">Topics</p><h2 id="topics">Explore by topic</h2><p>From your first route to production, and from your first component to a full single-page app.</p></div>
    </div>
    <div class="grid grid-4">
      {categories.map(c => (
        <a class="card tile topic reveal" href={`/category/${c.slug}`}>
          {categoryArt(c.slug) ? <div class="topic-art"><Art src={categoryArt(c.slug)!} alt={`Illustration for the ${c.name} topic`} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 300px" widths={[320, 480, 640]} /></div>
            : <span class="tile-icon"><Icon name={topicIcon[c.slug] ?? 'folder'} size={22} /></span>}
          <h3>{c.name}</h3>
          <p>{c.description}</p>
          <span class="count">{count(c.slug) ? `${count(c.slug)} ${count(c.slug) === 1 ? 'article' : 'articles'}` : 'Coming soon'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section-tight" aria-label="The stack we write about">
    <p class="kicker" style="text-align:center;margin-bottom:20px">The stack we write about</p>
    <div class="stack">{stack.map(s => <span class="chip"><i></i>{s}</span>)}</div>
    <p class="muted" style="text-align:center;margin-top:18px">The same stack, compared with 2019, is on <a href="/tools/now">Then and now</a>. Where each file goes in a new Vue starter kit is on <a href="/tools/files">Where it goes</a>. The October 2026 release notes are on <a href="/tools/shipped">What shipped</a>. The machine checks and the commands in order are on <a href="/tools/start">Start here</a>. The lines the setup guide shows are on <a href="/tools/samples">Samples</a>.</p>
  </section>

  <section class="container section-tight" aria-labelledby="jobs">
    <div class="jobs-band reveal">
      <div class="jobs-copy">
        <p class="kicker" style="color:var(--mint)">Jobs</p>
        <h2 id="jobs">Hiring Laravel or Vue developers?</h2>
        <p>Post your role to a community that writes this stack every day. Free in the jobs group, or featured across our page, channels and newsletter. Every listing is reviewed by a human.</p>
        <ul class="ticks">
          <li><Icon name="check" size={16} /> Freelance, contract and full-time roles</li>
          <li><Icon name="check" size={16} /> Remote-friendly, worldwide audience</li>
          <li><Icon name="check" size={16} /> No recruiter spam, no fake listings</li>
        </ul>
        <div class="row"><a class="btn btn-light" href="/jobs/create-job">Post a job <Icon name="arrow" size={16} class="icon-arrow" /></a><a class="btn btn-ghost-light" href="/jobs/job-archive">Browse roles</a></div>
      </div>
      <div class="jobs-art"><Art src={jobsArt} alt="Illustration of a briefcase between code windows and a rising bar chart, for Laravel and Vue jobs" sizes="(max-width: 860px) 100vw, 520px" widths={[480, 720, 1040]} /></div>
    </div>
  </section>

  <section class="container section-tight" aria-labelledby="community">
    <div class="section-head">
      <div><p class="kicker">Community</p><h2 id="community">Learn together, ship together</h2><p>Ask questions, share what you are building and find your next gig. Laravel and Vue developers from all over the world are already there.</p></div>
      <a class="link-arrow" href="/page/about-us">About the community <Icon name="arrow" size={16} /></a>
    </div>
    <div class="grid grid-2 bento" style="margin-bottom:24px">
      {GROUPS.map(g => (
        <a class="card tile group-card reveal" href={g.url} rel="noopener" target="_blank">
          <span class="tile-icon"><Icon name={g.name.includes('Jobs') ? 'briefcase' : 'users'} size={22} /></span>
          <h3>{g.name} <span class="muted" style="font-weight:400">· Facebook group</span></h3>
          <p>{g.description}</p>
          <span class="link-arrow">Join the group <Icon name="arrow-up-right" size={16} /></span>
        </a>
      ))}
    </div>
    <div class="grid grid-3">
      {SOCIALS.filter(s => s.id !== 'github').map(s => (
        <a class="card social-card reveal" href={s.url} rel="noopener" target="_blank">
          <span class="tile-icon"><Icon name={s.id} size={20} /></span>
          <span><strong>{s.name}</strong><small>{s.handle}</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
      ))}
    </div>
  </section>

  <NewsletterBand />
</Base>
