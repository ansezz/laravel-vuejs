---
import Base from '../layouts/Base.astro'
import Root from '../app/roots/NotFound.vue'
import { pageState } from '../lib/content'

const state = await pageState(Astro.url, { name: 'error' })
---
<Base seo={{ title: 'Mate, page not found!', description: 'Page not found' }} state={state}>
  <Root client:load />
</Base>
