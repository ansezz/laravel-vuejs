---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
---
<Base title="Page not found" noindex>
  <section class="hero" style="text-align:center">
    <div class="hero-bg"><span class="orb orb-a"></span><span class="orb orb-b"></span></div>
    <div class="container-narrow">
      <p class="kicker">Error 404</p>
      <h1 style="margin-top:16px"><span class="grad-text">Route [not.found]</span> is not defined.</h1>
      <p class="lead" style="margin-inline:auto">The page you are looking for has moved or never existed. Try searching, or head back home.</p>
      <div class="hero-cta" style="justify-content:center"><a class="btn btn-primary" href="/">Back home <Icon name="arrow" size={18} class="icon-arrow" /></a><a class="btn" href="/search"><Icon name="search" size={18} /> Search</a></div>
    </div>
  </section>
</Base>
