---
import PostCard from './PostCard.astro'
import PageHero from './PageHero.astro'
import Icon from './Icon.astro'
import NewsletterBand from './NewsletterBand.astro'
import Art from './Art.astro'
import type { ImageMetadata } from 'astro'
import { categories, type Post } from '../lib/content'
import { pageUrl } from '../lib/paginate'
interface Props { kicker: string; title: string; lead?: string; posts: Post[]; crumbs?: { label: string; href?: string }[]; art?: ImageMetadata; page?: { current: number; pages: number; prev?: string; next?: string } }
const { kicker, title, lead, posts, crumbs, art, page } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '')
---
<PageHero kicker={kicker} title={title} lead={lead} crumbs={crumbs}>
  <div class="card-cats" style="margin-top:28px">
    <a class={`chip ${path === '/posts' ? 'chip-brand' : ''}`} href="/posts">All</a>
    {categories.map(c => <a class={`chip ${path === '/category/' + c.slug ? 'chip-brand' : ''}`} href={`/category/${c.slug}`}>{c.name}</a>)}
  </div>
  {art && <div class="archive-art"><Art src={art} sizes="(max-width: 1240px) 100vw, 1180px" widths={[640, 960, 1280, 1600]} eager /></div>}
</PageHero>
<section class="container section-tight">
  {posts.length ? (<>
    <div class="grid grid-3">{posts.map(p => <PostCard post={p} headingLevel="h2" />)}</div>
    {page && page.pages > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {page.prev ? <a class="btn btn-sm" href={page.prev} rel="prev"><Icon name="arrow-left" size={14} /> Newer</a> : <span />}
        <ol>{Array.from({ length: page.pages }, (_, i) => i + 1).map(n => <li>{n === page.current ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)}>{n}</a>}</li>)}</ol>
        {page.next ? <a class="btn btn-sm" href={page.next} rel="next">Older <Icon name="arrow" size={14} /></a> : <span />}
      </nav>
    )}
  </>) : (
    <div class="empty">
      <div class="tile tile-icon" style="padding:0"><Icon name="sparkles" size={22} /></div>
      <h3>Nothing here yet</h3>
      <p>We have not published anything on this topic yet. Want to write the first article? Posts are Markdown files, and pull requests are welcome.</p>
      <a class="btn btn-primary" href="/who-we-are#write-for-the-blog">Write for us <Icon name="arrow" size={16} class="icon-arrow" /></a>
    </div>
  )}
</section>
<NewsletterBand />
