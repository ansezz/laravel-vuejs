---
import Base from '../layouts/Base.astro'
import PageHero from './PageHero.astro'
interface Props { title: string; lead: string; description?: string }
import { clip } from '../lib/content'
const { title, lead, description = clip(lead, 155) } = Astro.props
---
<Base title={title} description={description}>
  <PageHero
    kicker="Tools"
    title={title}
    lead={lead}
    crumbs={[{ label: 'Tools', href: '/tools' }, { label: title }]}
  />
  <section class="container section-tight tool-block">
    <slot />
  </section>
</Base>
