---
// Generated cover art in brand colours (no image download): gradient mesh + grid + logo mark.
import type { Post } from '../lib/content'
interface Props { post: Post }
const { post } = Astro.props
const x = 8 + (post.id * 37) % 70, y = 5 + (post.id * 29) % 60, a = (post.id * 67) % 360
const file = `${post.categories[0]?.slug ?? 'notes'}/${post.slug}.md`
---
<div class="cover" style={`--x:${x}%;--y:${y}%;--a:${a}deg`} aria-hidden="true">
  <svg class="cover-mark" viewBox="0 0 46 24"><path class="logo-shape" d="m27.9373935 3.21521902 7.3329187 18.66679308c.4987608 1.2682775 2.2943648 1.2682775 2.7923166.0001501l7.3339655-18.66691221c.181326-.46177913.1226026-.9833434-.1568664-1.39324118-.2794689-.40989778-.7435297-.65510242-1.2397279-.65500881l-14.6668443-.00000002c-.4959712.0001544-.9598032.24546065-1.2390949.65531864-.2792854.40984879-.33793.93125228-.1566674 1.39290022zm13.8611853.95178098-5.1315259 13.0645056-5.1326927-13.0645056zm-40.6315788-1.5-.00000001 15.9998929c.00049291 2.3006732 1.8654339 4.1656142 4.16600001 4.1661071h8c1.1520746 0 1.8743627-1.2442081 1.3028799-2.243928l-10.66701648-18.6670288c-.76270603-1.33492304-2.80186342-.79314845-2.80186342.7449568zm3.50175 7.53h.49825v.001h-.5zm0 0 .43237157-.24706947 5.64746823 9.88306947h-5.4155898c-.64414237 0-1.166-.5218576-1.166-1.166v-8.47zm19.33125 12.636c3.0375661 0 5.5-2.4624339 5.5-5.5s-2.4624339-5.5-5.5-5.5-5.5 2.4624339-5.5 5.5 2.4624339 5.5 5.5 5.5zm0-3c-1.3807119 0-2.5-1.1192881-2.5-2.5s1.1192881-2.5 2.5-2.5 2.5 1.1192881 2.5 2.5-1.1192881 2.5-2.5 2.5zm-6-7.666c3.0375661 0 5.4999999-2.46243391 5.4999999-5.5s-2.4624338-5.49999995-5.4999999-5.5c-1.9649608-.00000003-3.7806594 1.04829404-4.7631398 2.74999998-.9824804 1.70170593-.9824804 3.79829411 0 5.50000004.9824804 1.70170598 2.798179 2.74999998 4.7631398 2.74999998zm0-3c-1.3807119 0-2.5-1.11928813-2.5-2.5s1.1192881-2.5 2.5-2.5 2.5 1.11928813 2.5 2.5-1.1192881 2.5-2.5 2.5z"/></svg>
  <div class="cover-inner">
    <span class="cover-file">{file}</span>
    <span class="cover-cmd"><b>$</b> {post.snippet}<i></i></span>
  </div>
</div>
